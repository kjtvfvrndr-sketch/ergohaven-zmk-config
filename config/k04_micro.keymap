/*
 * K04 Micro — 36 клавиш, порядок позиций ИДЕНТИЧЕН op36
 * (0-9 верхний ряд, 10-19 средний, 20-29 нижний, 30-35 большие пальцы).
 *
 * Содержимое перенесено из rmk-eh/keyboards/k04_micro/keyboard.toml.
 * Две позиции модульного отсека (кнопка энкодера) не включены — у вас
 * там трекбол, см. комментарий в k04_micro.dtsi.
 *
 * ВАЖНО: раз позиции совпадают с op36, вместо этого файла можно
 * подключить готовый config/op36_ruen.keymap из репозитория — он
 * заработает без единой правки, вместе с hml/hmr и RU/EN макросами.
 * См. README.
 *
 * Осталось решить самому:
 *  - "User19..User46" — кастомные RMK-макросы, их смысла нет в keyboard.toml.
 *    Помечены &none. Скорее всего это ровно то, что в ZMK уже реализовано
 *    в op36_ruen.keymap как to_ru/to_en/layer_ru/layer_en/&en(..).
 *  - Слой Pointing ни на что не повешен (в RMK активатор задан в Rust-коде).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q        &kp W        &kp E          &kp R          &kp T             &kp Y      &kp U          &kp I          &kp O        &kp P
&mt LGUI A   &mt LALT S   &mt LSHFT D    &mt LCTRL F    &kp G             &kp H      &mt RCTRL J    &mt RSHFT K    &mt RALT L   &mt RGUI SEMI
&kp Z        &kp X        &kp C          &kp V          &kp B             &kp N      &kp M          &kp COMMA      &kp DOT      &kp SQT
                          &kp BSPC       &mo 1          &kp SPACE         &kp RET    &mo 2          &kp TAB
&none        &none
            >;

            /* Порядок соответствует sensors = <&encoder_L1 &encoder_R1>:
               первый — левый энкодер, второй — правый.
               Правый в вашей сборке физически отсутствует (там трекбол),
               его биндинг просто никогда не сработает. */
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            bindings = <
&kp N1          &kp N2       &kp N3         &kp N4         &kp N5            &kp N6     &kp N7         &kp N8         &kp N9        &kp N0
&mt LGUI HOME   &mt LALT INS &mt LSHFT DEL  &mt LCTRL END  &kp RET           &kp ESC    &mt RCTRL LEFT &mt RSHFT DOWN &mt RALT UP   &mt RGUI RIGHT
&kp PG_UP       &kp PG_DN    &none          &none          &kp PSCRN         &none      &none          &none          &kp CAPS      &caps_word
                             &none          &none          &none             &none      &mo 3          &none
&none        &none
            >;
        };

        symbols_layer {
            bindings = <
&kp AT          &kp LT       &kp EQUAL      &kp GT         &kp GRAVE         &kp CARET  &kp DQT        &kp UNDER      &kp SQT       &none
&mt LGUI BSLH   &none        &mt LSHFT MINUS &none         &kp PLUS          &kp PERCENT &none         &mt RSHFT SEMI &none         &none
&kp HASH        &kp STAR     &kp COLON      &kp FSLH       &none             &none      &kp PIPE       &kp TILDE      &kp AMPS      &kp DOLLAR
                             &none          &mo 3          &none             &none      &none          &none
&none        &none
            >;
        };

        adjust_layer {
            bindings = <
&bootloader     &kp F1       &kp F2         &kp F3         &kp F4            &none      &none          &none          &none         &none
&kp LGUI        &mt LALT F5  &mt LSHFT F6   &mt LCTRL F7   &kp F8            &none      &mt RCTRL C_VOL_DN &mt RSHFT C_MUTE &mt RALT C_VOL_UP &none
&none           &kp F9       &kp F10        &kp F11        &kp F12           &none      &kp C_PREV     &kp C_PP       &kp C_NEXT    &none
                             &none          &none          &none             &none      &none          &none
&none        &none
            >;
        };

        pointing_layer {
            bindings = <
&none        &none        &none          &none          &none             &none      &none          &none          &none        &none
&none        &mkp MB3     &mkp MB2       &mkp MB1       &none             &none      &mkp MB1       &mkp MB2       &mkp MB3     &none
&none        &none        &none          &none          &none             &none      &mkp MB4       &mkp MB5       &none        &none
                          &none          &none          &none             &none      &none          &none
&none        &none
            >;
        };
    };
};
