#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "k04_micro_layout.dtsi"
#include <zephyr/dt-bindings/led/led.h>
#include <behaviors/rgbled_widget.dtsi>

/ {
    chosen {
      zmk,kscan = &kscan0;
      zmk,physical-layout = &physical_layout;
      zmk,battery = &vbatt;
    };
    
    default_transform: keymap_transform_0 {
      compatible = "zmk,matrix-transform";
      columns = <12>;
      rows = <4>;
      map = <
RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                RC(3,3) RC(3,2) RC(3,1)    RC(3,7) RC(3,8) RC(3,9)
      >;
    };

    kscan0: kscan {
      /* col2row — ПОДТВЕРЖДЕНО, не догадка. Два независимых доказательства:
         1) в rmk-eh/keyboards/k04_micro/src/deep_sleep.rs колонки объявлены
            как COL_OUTPUT_PINS (= выходы), ряды как ROW_WAKE_PINS (= входы);
            в матрице RMK OUTPUT_PIN_NUM = COL ровно при COL2ROW = true;
         2) у op36 то же соответствие пинов, и рабочий ZMK-шилд использует
            col2row с PULL_DOWN на row-gpios. */
      diode-direction = "col2row";
      wakeup-source;
    };

    vbatt: vbatt {
        status = "okay";
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 7>;
        output-ohms = <1564000>;
        full-ohms = <(636000 + 1564000)>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

/*
 * K04 Micro разводит трекбол на ДРУГИЕ пины, чем остальные платы Ergohaven:
 *   sck  = P0_01   (у прочих — P0_08)
 *   sdio = P0_00   (общий MOSI/MISO, у прочих — P0_17)
 *   cs   = P0_05   (у прочих — P0_13)
 *   irq  = P1_09   (у прочих — P0_15)
 * Поэтому дефолтный pinctrl платы (boards/arm/ergohaven/ergohaven-pinctrl.dtsi)
 * здесь переопределяется. Это безопасно: P0.00/P0.01 на nRF52840 — пины
 * кварца XL1/XL2, НО плата ergohaven собрана с CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC
 * (внутренний RC-генератор), внешнего 32 кГц кварца нет — пины свободны.
 */
&spi0_default {
    group1 {
        psels = <NRF_PSEL(SPIM_SCK, 0, 1)>,
                <NRF_PSEL(SPIM_MOSI, 0, 0)>,
                <NRF_PSEL(SPIM_MISO, 0, 0)>;
    };
};

&spi0_sleep {
    group1 {
        psels = <NRF_PSEL(SPIM_SCK, 0, 1)>,
                <NRF_PSEL(SPIM_MOSI, 0, 0)>,
                <NRF_PSEL(SPIM_MISO, 0, 0)>;
        low-power-enable;
        bias-pull-up;
    };
};

&spi0 {
    status = "disabled";
    cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "disabled";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <1000>;
        swap-xy;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

/* Узел leds платы ergohaven сидит на P1.10 — у K:04 Micro это row-gpio.
   Драйвер led_gpio по умолчанию не собирается, но узел лучше погасить явно. */
/ {
    leds {
        status = "disabled";
    };
};

/*
 * WS2812-совместимый диод, один на половину, data на P0.30.
 * Пин подтверждён по RMK: rmk/keyboards/k04/src/{central,left,right,
 * peripheral}.rs — во всех четырёх ролях
 *     SequencePwm::new_1ch(p.PWM0, p.P0_30, config)
 * Порядок байт GRB — из send_color() в layer_led.rs, где буфер [g, r, b].
 *
 * ВАЖНО: используется SPI-бэкенд, а не GPIO. В Zephyr 3.5 (который тянет
 * ZMK v0.3.0) драйвер ws2812_gpio объявлен как
 *     config WS2812_STRIP_GPIO
 *         depends on SOC_SERIES_NRF51X
 * то есть на nRF52840 его включить нельзя — Kconfig просто не даст.
 *
 * spi1 выбран сознательно, не spi3: у SPIM3 на nRF52840 есть известная
 * аномалия с повышенным током покоя после передачи, а для батарейной
 * половины это лишний риск. spi1 — обычный SPIM, максимум 8 МГц, нам
 * нужно 4 МГц. Плата его нигде не занимает (i2c0 сидит на TWI0, трекбол
 * на spi0).
 */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            /* SCK не выводится наружу: для WS2812 нужен только MOSI, а
               драйвер spi_nrfx_spim корректно обрабатывает
               nrfy_spim_sck_pin_get() < 0. Это экономит свободный пин и
               убирает паразитные 4 МГц на плате. */
            psels = <NRF_PSEL(SPIM_MOSI, 0, 30)>,
                    <NRF_PSEL_DISCONNECTED(SPIM_SCK)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 30)>,
                    <NRF_PSEL_DISCONNECTED(SPIM_SCK)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;

        /* Тайминг. На 4 МГц один бит SPI = 250 нс.
           spi-zero-frame 0x40 = 0b01000000 -> T0H 250 нс (спек 200-500)
           spi-one-frame  0x70 = 0b01110000 -> T1H 750 нс (спек 550-850)
           Период байта 2 мкс против номинальных 1.25 мкс — WS2812 это
           терпит, порог сброса ~50 мкс. Это же сочетание используется в
           штатных примерах Zephyr.
           4 МГц — валидная частота SPIM на nRF52840 (ряд дискретный:
           125k/250k/500k/1M/2M/4M/8M). */
        spi-max-frequency = <4000000>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        chain-length = <1>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
        reset-delay = <280>;
    };
};

/ {
    aliases {
        led-strip = &led_strip;
    };
};