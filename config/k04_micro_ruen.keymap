/*
 * K:04 Micro — RU/EN вариант (аналог op36_ruen.keymap)
 *
 * Состав:
 *   - позиции 0-35 и все слои: 1:1 из config/op36_ruen.keymap
 *   - позиции 36,37: кнопки модульных отсеков K:04 (у op36 их нет)
 *   - sensor-bindings энкодеров: модель config/imperial44.keymap
 *   - слои Mouse/Scroll/Sniper и обвязка трекбола: из
 *     config/velvet_v3_ui_ruen.keymap, расстановка перенесена
 *     с 6 колонок velvet на 5 колонок K:04
 *
 * Слои: en=0, ru=1, sym_en=2, sym_ru=3, nav=4, adj=5, add_1=6, add_2=7, mouse=8, scroll=9, sniper=10
 *
 * Ряд указателя (mouse): мизинец=Scroll, безым.=ПКМ, средний=СКМ,
 * указат.=ЛКМ, внутр.=Sniper — зеркально на обеих половинах.
 * Слой Mouse включается сам при движении трекбола (zip_auto_mouse).
 */
#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/input_gestures_accel.dtsi>

/ {
    input_processors {
        xy_fine: xy_fine {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
        };
    };

    accel_scroll: accel_scroll {
        compatible = "zmk,input-processor-acceleration";
        status = "okay";
        #input-processor-cells = <0>;
        input-type = <INPUT_EV_REL>;
        track-remainders;
        min-factor = <1000>;
        max-factor = <5000>;
        speed-threshold = <1000>;
        speed-max = <8000>;
        acceleration-exponent = <3>;
    };
};

&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;
    min-factor = <1000>;
    max-factor = <7500>;
    speed-threshold = <500>;
    speed-max = <12000>;
    acceleration-exponent = <3>;
};

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {

        zip_auto_mouse: zip_auto_mouse {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <800>;
            excluded-positions = <10 11 12 13 14>;
        };
       
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35 32>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        lg_space: lg_space {
            compatible = "zmk,behavior-mod-morph";
            label = "toggle 'ru' layer with LGUI";
            bindings = <&kp SPACE>, <&lg_tog>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <6 7>;
            layers = <1>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <7 8>;
            layers = <1>;
        };

        ru_io {
            bindings = <&kp RU_CYRILLIC_IO>;
            key-positions = <3 4>;
            layers = <1>;
        };

        cmbenru {
            bindings = <&tog 1>;
            key-positions = <2 3>;
            layers = <0 1>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        lg_tog: lg_tog {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &tog 1>;
            label = "LG_TOG";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &kp Q         &kp W        &kp E        &kp R          &kp T                          &kp Y  &kp U         &kp I        &kp O        &kp P
  &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F   &kp G                          &kp H  &hmr RSHFT J  &hmr RGUI K  &hmr LALT L  &hmr RCTRL SEMICOLON
  &kp Z         &kp X        &kp C        &kp V          &kp B                          &kp N  &kp M         &kp COMMA    &kp DOT      &kp SQT
                                          &kp BACKSPACE  &mo 4  &lg_space    &kp ENTER  &mo 2  &kp TAB
  &none         &none        /* 36,37: кнопки модульных отсеков K:04 */
            >;

            display-name = "Base";

            /* Энкодеры модульных отсеков, порядок как в
               sensors = <&encoder_L1 &encoder_R1>. Правый отсек занят
               трекболом, его биндинг просто не сработает. */
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        ru {
            bindings = <
  &kp RU_CYRILLIC_SHORT_I    &kp RU_CYRILLIC_TSE         &kp RU_CYRILLIC_U         &kp RU_CYRILLIC_KA        &kp RU_CYRILLIC_IE                          &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA       &kp RU_CYRILLIC_SHCHA     &kp RU_CYRILLIC_ZE
  &hml LCTRL RU_CYRILLIC_EF  &hml LALT RU_CYRILLIC_YERU  &hml LGUI RU_CYRILLIC_VE  &hml LSHFT RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                          &kp RU_CYRILLIC_ER  &hmr RSHFT RU_CYRILLIC_O   &hmr RGUI RU_CYRILLIC_EL  &hmr LALT RU_CYRILLIC_DE  &hmr RCTRL RU_CYRILLIC_ZHE
  &kp RU_CYRILLIC_YA         &kp RU_CYRILLIC_CHE         &kp RU_CYRILLIC_ES        &kp RU_CYRILLIC_EM        &kp RU_CYRILLIC_I                           &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE        &kp RU_CYRILLIC_YU        &kp RU_CYRILLIC_E
                                                                                   &kp BACKSPACE             &mo 4               &lg_space    &kp ENTER  &mo 3               &kp TAB
  &none         &none        /* 36,37: кнопки модульных отсеков K:04 */
            >;

            display-name = "Ru";
        };

        sym_en {
            bindings = <
  &kp TILDE        &kp LT          &kp EQUAL        &kp GT           &kp GRAVE                    &kp CARET  &kp LBKT         &kp UNDER       &kp RBKT        &kp DLLR
  &hml LCTRL BSLH  &hml LALT LPAR  &hml LGUI MINUS  &hml LSHFT RPAR  &kp PLUS                     &kp PRCNT  &hmr RSHFT LBRC  &hmr RGUI SEMI  &hmr LALT RBRC  &hmr RCTRL EXCL
  &kp HASH         &kp STAR        &kp COLON        &kp FSLH         &kp AMPS                     &kp AT     &kp PIPE         &kp COMMA       &kp DOT         &kp QMARK
                                                    &trans           &mo 5      &trans    &trans  &none      &trans
  &trans        &trans       /* 36,37: кнопки модульных отсеков K:04 */
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &en TILDE                &en LT          &kp EQUAL        &en GT           &en GRAVE                    &en CARET  &en LBKT  &kp UNDER          &en RBKT    &en DLLR
  &hml LCTRL RU_BACKSLASH  &hml LALT LPAR  &hml LGUI MINUS  &hml LSHFT RPAR  &kp PLUS                     &kp PRCNT  &en LBRC  &hmr RGUI RU_SEMI  &en RBRC    &hmr RCTRL EXCL
  &en HASH                 &kp STAR        &kp RU_COLON     &kp RU_FSLH      &en AMPS                     &en AT     &en PIPE  &kp RU_COMMA       &kp RU_DOT  &kp RU_QMARK
                                                            &trans           &mo 5      &trans    &trans  &none      &trans
  &trans        &trans       /* 36,37: кнопки модульных отсеков K:04 */
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &kp N1          &kp N2    &kp N3    &kp N4     &kp N5                        &kp N6           &kp N7           &kp N8          &kp N9        &kp N0
  &hml LCTRL ESC  &kp LALT  &kp LGUI  &kp LSHFT  &kp ENTER                     &kp PRINTSCREEN  &hmr RSHFT LEFT  &hmr RGUI DOWN  &hmr LALT UP  &hmr RCTRL RIGHT
  &layer_en       &kp HOME  &kp INS   &kp END    &kp DELETE                    &kp CAPS         &none            &kp PG_DN       &kp PG_UP     &layer_ru
                                      &trans     &none       &trans    &trans  &mo 5            &trans
  &trans        &trans       /* 36,37: кнопки модульных отсеков K:04 */
            >;

            display-name = "Nav";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2        &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2      &bt BT_SEL 3        &bt BT_CLR
  &kp LCTRL    &hml LALT F5  &hml LGUI F6  &hml LSHFT F7  &kp F8                     &out OUT_BLE  &hmr RSHFT C_VOL_DN  &hmr RGUI C_MUTE  &hmr LALT C_VOL_UP  &kp RCTRL
  &to 6        &kp F9        &kp F10       &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP          &kp C_NEXT          &studio_unlock
                                           &trans         &trans   &trans    &trans  &trans        &trans
  &trans        &trans       /* 36,37: кнопки модульных отсеков K:04 */
            >;

            display-name = "Adjust";
        };

        add_1 {
            bindings = <
  &mt ESC TAB  &kp Q  &kp W  &kp E         &kp R                          &kp T  &none     &kp UP    &none            &kp ESC
  &kp LSHFT    &kp A  &kp S  &kp D         &kp F                          &kp G  &kp LEFT  &kp DOWN  &kp RIGHT_ARROW  &none
  &kp LCTRL    &kp Z  &kp X  &kp C         &kp V                          &kp B  &none     &none     &none            &to 0
                             &kp LEFT_ALT  &mo 4  &kp SPACE    &kp ENTER  &mo 5  &kp RGUI
  &none         &none        /* 36,37: кнопки модульных отсеков K:04 */
            >;

            label = "Gaming";
        };

        add_2 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans    &trans  &trans  &trans
  &trans        &trans       /* 36,37: кнопки модульных отсеков K:04 */
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&mo 9      &mkp MB3   &mkp MB2   &mkp MB1   &mo 10     &mo 10     &mkp MB1   &mkp MB2   &mkp MB3   &mo 9    
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans   &trans   &trans     &trans   &trans   &trans
&trans   &trans
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &mkp MB3   &mkp MB2   &mkp MB1   &trans     &trans     &mkp MB1   &mkp MB2   &mkp MB3   &trans   
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans   &trans   &trans     &trans   &trans   &trans
&trans   &trans
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &mkp MB3   &mkp MB2   &mkp MB1   &trans     &trans     &mkp MB1   &mkp MB2   &mkp MB3   &trans   
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans   &trans   &trans     &trans   &trans   &trans
&trans   &trans
            >;

            display-name = "Sniper";
        };
    };
};

&trackball_listener {
    input-processors = <&zip_auto_mouse 8 1000>, <&pointer_accel>, <&xy_fine 2 5>;

    scroller {
        layers = <9>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&accel_scroll>,
            <&xy_fine 1 64>,
            <&zip_xy_to_scroll_mapper>;
    };

    sniper {
        layers = <10>;
        input-processors = <&xy_fine 1 4>;
    };
};

&mkp_input_listener {
    input-processors = <&zip_auto_mouse 8 1000>;
};